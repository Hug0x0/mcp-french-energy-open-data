{
  "name": "mcp-french-energy-open-data",
  "version": "0.1.0",
  "description": "MCP server for French open energy data: ODRE, \u00e9CO2mix, RTE/Enedis source discovery, and electricity mix helpers.",
  "type": "module",
  "bin": {
    "mcp-french-energy-open-data": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "open-data",
    "france",
    "energy",
    "rte",
    "enedis",
    "odre",
    "eco2mix"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hug0x0/mcp-french-energy-open-data.git"
  },
  "bugs": {
    "url": "https://github.com/Hug0x0/mcp-french-energy-open-data/issues"
  },
  "homepage": "https://github.com/Hug0x0/mcp-french-energy-open-data#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
